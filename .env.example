# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=8h

# ── Database (Turso) ─────────────────────────────────────────────────────────
# Local dev: uses local SQLite file (no Turso account needed)
TURSO_DATABASE_URL=file:./src/db/favo.db
TURSO_AUTH_TOKEN=

# Production (Turso cloud):
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Yoco Payments ─────────────────────────────────────────────────────────────
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
