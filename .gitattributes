# Normalise line endings to LF on commit, checkout as LF on all platforms.
# This prevents CRLF/LF conflicts between Windows and Unix contributors.

* text=auto eol=lf

# Force binary — never touch line endings for these types.
*.db        binary
*.db-shm    binary
*.db-wal    binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.pdf       binary
*.zip       binary

# Force text with explicit LF for source files.
*.js        text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.env       text eol=lf
*.example   text eol=lf
.gitignore  text eol=lf
