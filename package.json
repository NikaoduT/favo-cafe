{
  "name": "favo-cafe",
  "version": "1.0.0",
  "description": "Favo Cafe and Roastery - POS, CRM, Inventory and Loyalty Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/db/seed.js",
    "migrate": "node src/db/migrate.js",
    "build": "echo 'No build step required'",
    "postinstall": "node -e \"const fs=require('fs');const dir=process.env.DB_PATH?require('path').dirname(process.env.DB_PATH):'./src/db';fs.mkdirSync(dir,{recursive:true});\""
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
